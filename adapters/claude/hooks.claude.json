{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/llm-speed-bench}/adapters/claude/speed-hook.mjs\" --agent claude",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/llm-speed-bench}/adapters/claude/speed-hook.mjs\" --agent claude",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
